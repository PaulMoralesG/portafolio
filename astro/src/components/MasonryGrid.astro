---
import photos from '../data/photos.json';
const BASE = "https://images-pw.pixieset.com/site/BpdnAE";
const catLabel = {
  bodas: 'boda', xv: 'XV años', comunion: 'primera comunión',
  sesiones: 'sesión fotográfica', cumple: 'cumpleaños',
  revelacion: 'revelación de género', arte: 'evento artístico'
};
const altText = (cat) => cat === 'sesiones'
  ? 'Sesión fotográfica en Guayaquil — Sara Sánchez'
  : `Fotografía de ${catLabel[cat]} en Guayaquil — Sara Sánchez`;
---
<section id="galeria" style="background:var(--black)"><div class="container">
  <style>
    .tabs{display:flex;gap:.4rem;justify-content:center;flex-wrap:wrap;margin-bottom:2rem}
    .tab{padding:7px 16px;border-radius:50px;font-size:11px;font-weight:500;border:1px solid rgba(255,255,255,.1);background:transparent;color:rgba(255,255,255,.5);cursor:pointer;transition:all .2s;font-family:inherit}
    .tab:hover{color:var(--white);border-color:rgba(255,255,255,.3)}.tab.active{background:var(--wine);color:var(--white);border-color:var(--wine)}
    .cat-header{display:none;text-align:center;margin-bottom:1.5rem}.cat-header h3{font-family:Georgia,serif;color:var(--rose);font-size:1.4rem;font-weight:400;margin-bottom:.5rem}.cat-header p{color:rgba(255,255,255,.6);font-size:.9rem;max-width:500px;margin:0 auto;font-style:italic;line-height:1.6}
    .masonry{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));grid-auto-rows:100px;gap:.5rem;grid-auto-flow:dense;touch-action:manipulation}
    .item{border-radius:6px;position:relative;cursor:pointer;touch-action:manipulation;-webkit-user-select:none;user-select:none;min-height:80px;overflow:hidden}
    .item img{width:100%;height:100%;object-fit:cover;display:block;min-height:100px;transition:all .5s;background:rgba(107,29,47,.12);border-radius:6px}
    .item:hover img{transform:scale(1.04);filter:brightness(1.08)}.item:active img{transform:scale(.97);transition:transform .1s}
    .item .label{position:absolute;inset:0;border-radius:6px;background:rgba(0,0,0,0);display:flex;align-items:flex-end;padding:.8rem;color:var(--white);font-size:11px;font-weight:500;opacity:0;transition:all .3s;pointer-events:none}
    .item:hover .label{opacity:1;background:rgba(0,0,0,.35)}
    .lb{position:fixed;inset:0;z-index:999;background:rgba(0,0,0,.96);display:none;align-items:center;justify-content:center;touch-action:none}.lb.open{display:flex}
    .lb .lb-wrap{position:relative;width:92vw;height:82vh;display:flex;align-items:center;justify-content:center}
    .lb .lb-img{max-width:100%;max-height:100%;object-fit:contain;border-radius:6px;position:absolute;transition:opacity .3s ease}
    .lb .lb-img.on{opacity:1}.lb .lb-img.off{opacity:0;pointer-events:none}
    .lb .lb-close{position:absolute;top:.8rem;right:.8rem;color:#fff;font-size:2rem;width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,255,255,.06);z-index:1001;cursor:pointer;border:none}
    .lb .lb-nav{position:absolute;top:50%;transform:translateY(-50%);color:#fff;font-size:2.2rem;width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,255,255,.06);z-index:1001;cursor:pointer;border:none;user-select:none;transition:background .2s}
    .lb .lb-nav:active{background:rgba(255,255,255,.2)}.lb .lb-prev{left:.5rem}.lb .lb-next{right:.5rem}
    .lb .lb-count{position:absolute;bottom:1rem;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.55);font-size:12px;letter-spacing:1px}
    @media(max-width:768px){.lb .lb-nav{width:40px;height:40px;font-size:1.8rem}.lb .lb-prev{left:.3rem}.lb .lb-next{right:.3rem}.lb .lb-close{width:40px;height:40px;font-size:1.8rem;top:.5rem;right:.5rem}}
  </style>
  <div class="head"><span class="tag">Portafolio</span><h2>Trabajos recientes</h2><p>91 fotos — cada una en su proporción natural</p></div>
  <div class="tabs">
    <button class="tab active" onclick="filterAll(this)">Todas</button>
    <button class="tab" onclick="filterCat('bodas',this)">Bodas</button>
    <button class="tab" onclick="filterCat('xv',this)">XV Años</button>
    <button class="tab" onclick="filterCat('comunion',this)">Comunión</button>
    <button class="tab" onclick="filterCat('sesiones',this)">Sesiones</button>
    <button class="tab" onclick="filterCat('cumple',this)">Cumpleaños</button>
    <button class="tab" onclick="filterCat('revelacion',this)">Revelación</button>
    <button class="tab" onclick="filterCat('arte',this)">Artísticos</button>
  </div>
  <div class="cat-header" id="catHeader"><h3 id="catTitle"></h3><p id="catDesc"></p></div>
  <div class="masonry" id="masonry">
    {photos.map(p => (
      <div class="item" data-cat={p.cat} style={`grid-row:span ${p.h};grid-column:span ${p.w}`} onclick="openLb(this)">
        <img src={`${BASE}/${p.src}`} alt={altText(p.cat)} loading="lazy">
        <span class="label">{p.cat === 'bodas' ? 'Bodas' : p.cat === 'xv' ? 'XV Años' : p.cat === 'comunion' ? 'Comunión' : p.cat === 'sesiones' ? 'Sesiones' : p.cat === 'cumple' ? 'Cumpleaños' : p.cat === 'revelacion' ? 'Revelación' : 'Artísticos'}</span>
      </div>
    ))}
  </div>
  <div class="lb" id="lb">
    <button class="lb-close" onclick="lbClose()">&times;</button>
    <button class="lb-nav lb-prev" onclick="lbNav(-1)">‹</button>
    <div class="lb-wrap" onclick="event.stopPropagation();lbNav(1)">
      <img class="lb-img on" id="lb1" src="" alt="" onclick="event.stopPropagation();lbNav(1)">
      <img class="lb-img off" id="lb2" src="" alt="" onclick="event.stopPropagation();lbNav(1)">
    </div>
    <button class="lb-nav lb-next" onclick="lbNav(1)">›</button>
    <span class="lb-count" id="lbCount"></span>
  </div>
</div></section>

<script>
  var catInfo={bodas:{title:"Bodas",desc:"La fotografía es romántica"},xv:{title:"XV Años",desc:"Los 15 años son recuerdos que brillan para siempre. Es la mejor manera de guardar esa etapa mágica, capturando sonrisas, emociones y recuerdos que durarán toda la vida."},comunion:{title:"Primera Comunión",desc:"Más que una celebración, la primera comunión es un paso importante en la vida espiritual de un niño. Mis fotografías buscan inmortalizar la esencia de ese día: la alegría, la emoción y la unión familiar que lo hacen único."},sesiones:{title:"Sesiones Fotográficas",desc:"Historias contadas con pura luz"},cumple:{title:"Cumpleaños",desc:"Busco capturar toda la diversión, la emoción y la magia de un día que solo se vive una vez al año. ¡Feliz cumpleaños!"},revelacion:{title:"Revelación de Género",desc:"Amor, alegría y esperanza en cada fotografía"},arte:{title:"Eventos Artísticos",desc:"Guayaquil"}};
  function filterCat(cat,btn){document.querySelectorAll('.tab').forEach(function(b){b.classList.remove('active')});btn.classList.add('active');document.querySelectorAll('.item').forEach(function(i){i.style.display=(i.dataset.cat===cat)?'block':'none'});var h=document.getElementById('catHeader');var t=document.getElementById('catTitle');var d=document.getElementById('catDesc');if(catInfo[cat]){h.style.display='block';t.textContent=catInfo[cat].title;d.textContent=catInfo[cat].desc}else{h.style.display='none'}}
  function filterAll(btn){document.querySelectorAll('.tab').forEach(function(b){b.classList.remove('active')});btn.classList.add('active');document.querySelectorAll('.item').forEach(function(i){i.style.display='block'});document.getElementById('catHeader').style.display='none'}
  var lbImgs=[],lbIdx=0,lbSlot=1,lbPre={},lbLoading=false;
  function openLb(el){var src=el.tagName==='IMG'?el.src:el.querySelector('img').src;lbImgs=Array.from(document.querySelectorAll('.item:not([style*="display: none"]) img')).map(function(i){return i.src});lbIdx=lbImgs.indexOf(src);if(lbIdx<0)lbIdx=0;lbSlot=1;var img1=document.getElementById('lb1');var img2=document.getElementById('lb2');img1.src=lbImgs[lbIdx];img1.className='lb-img on';img2.className='lb-img off';img2.src='';document.getElementById('lbCount').textContent=(lbIdx+1)+' / '+lbImgs.length;document.getElementById('lb').classList.add('open');document.body.style.overflow='hidden';lbPreload()}
  function lbPreload(){[-1,1,2,-2].forEach(function(o){var i=(lbIdx+o+lbImgs.length)%lbImgs.length;if(!lbPre[lbImgs[i]]){var img=new Image();img.src=lbImgs[i];lbPre[lbImgs[i]]=true}})}
  function lbClose(){document.getElementById('lb').classList.remove('open');document.body.style.overflow=''}
  function lbNav(dir){if(lbLoading)return;var nextIdx=(lbIdx+dir+lbImgs.length)%lbImgs.length;var ns=lbSlot==1?2:1;var ni=document.getElementById('lb'+ns);var ci=document.getElementById('lb'+lbSlot);lbLoading=true;ni.onload=function(){ni.className='lb-img on';ci.className='lb-img off';ci.src='';lbSlot=ns;lbIdx=nextIdx;document.getElementById('lbCount').textContent=(lbIdx+1)+' / '+lbImgs.length;lbLoading=false;lbPreload()};ni.onerror=function(){lbLoading=false};ni.src=lbImgs[nextIdx]}
  document.onkeydown=function(e){if(!document.getElementById('lb').classList.contains('open'))return;if(e.key=='Escape')lbClose();if(e.key=='ArrowLeft')lbNav(-1);if(e.key=='ArrowRight')lbNav(1)};
  var tsX=0,tsY=0;document.getElementById('lb').addEventListener('touchstart',function(e){tsX=e.touches[0].clientX;tsY=e.touches[0].clientY},{passive:true});document.getElementById('lb').addEventListener('touchend',function(e){if(!document.getElementById('lb').classList.contains('open'))return;var dx=e.changedTouches[0].clientX-tsX;var dy=e.changedTouches[0].clientY-tsY;if(Math.abs(dx)>Math.abs(dy)&&Math.abs(dx)>40)lbNav(dx>0?-1:1)});
  var observer=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.style.opacity='1';e.target.style.transform='translateY(0)'}})},{threshold:.08});
  document.querySelectorAll('.item').forEach(function(el){el.style.opacity='0';el.style.transform='translateY(16px)';el.style.transition='all .5s ease-out';observer.observe(el)});
</script>