---
export interface Props { title: string; }
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <link rel="canonical" href="https://paulmoralesg.github.io/portafolio">
  <meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
  <meta name="description" content="Sara Sánchez — Fotógrafa profesional en Guayaquil, Ecuador. Bodas, XV Años, Primera Comunión, sesiones y eventos. Contáctame por WhatsApp.">
  <meta property="og:title" content="Sara Sánchez — Fotografía">
  <meta property="og:description" content="La fotografía es romántica. Capturo momentos auténticos con luz natural y emoción.">
  <meta property="og:image" content="https://images-pw.pixieset.com/site/BpdnAE/kX7mqX/DSC_0925-d64e69f2-1500.jpg">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 46 46'%3E%3Crect x='2' y='10' width='42' height='30' rx='6' stroke='%236b1d2f' stroke-width='2.5' fill='none'/%3E%3Ccircle cx='23' cy='25' r='10' stroke='%236b1d2f' stroke-width='2.5' fill='none'/%3E%3Ccircle cx='23' cy='25' r='3.5' fill='%236b1d2f'/%3E%3C/svg%3E">
  <title>{title} — Sara Sánchez</title>
  <style>
    @import '../styles/global.css';
    nav{position:fixed;top:0;left:0;right:0;z-index:50;padding:1rem 1.5rem;display:flex;justify-content:space-between;align-items:center;transition:all .3s}
    nav.scrolled{background:rgba(0,0,0,.96);backdrop-filter:blur(20px)}
    nav .brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--white);z-index:52}
    nav .brand span{font-family:Georgia,serif;font-size:1.05rem;letter-spacing:2px;font-weight:600}
    nav a.link{color:rgba(255,255,255,.7);text-decoration:none;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-left:1.5rem;transition:color .2s}
    nav a.link:hover{color:var(--rose-light)}
    .ham{display:none;flex-direction:column;gap:5px;cursor:pointer;z-index:52;background:none;border:none;padding:8px}
    .ham span{display:block;width:22px;height:2px;background:var(--white);border-radius:2px;transition:all .3s}
    .ham.active span:nth-child(1){transform:rotate(45deg) translate(5px,5px)}.ham.active span:nth-child(2){opacity:0}.ham.active span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px)}
    .mmenu{position:fixed;inset:0;background:var(--black);z-index:51;display:none;flex-direction:column;align-items:center;justify-content:center;gap:2rem}
    .mmenu.open{display:flex}
    .mmenu a{color:var(--white);text-decoration:none;font-size:1.5rem;font-family:Georgia,serif;transition:color .2s}
    .mmenu a:hover{color:var(--rose)}
    .float-wa{position:fixed;bottom:1.5rem;right:1.5rem;z-index:200;width:60px;height:60px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.35);transition:all .3s;animation:waPulse 2s infinite}
    .float-wa:hover{transform:scale(1.1);box-shadow:0 8px 28px rgba(37,211,102,.45);animation:none}
    .float-wa:active{transform:scale(.95)}
    @keyframes waPulse{0%{box-shadow:0 4px 16px rgba(37,211,102,.35)}50%{box-shadow:0 4px 28px rgba(37,211,102,.55)}100%{box-shadow:0 4px 16px rgba(37,211,102,.35)}}
    @media(max-width:768px){.float-wa{bottom:1rem;right:1rem;width:56px;height:56px}}
    footer{padding:3rem 1.5rem;text-align:center;color:rgba(255,255,255,.25);font-size:11px}
  </style>
</head>
<body>
  <nav id="nav">
    <a href="#" class="brand">
      <svg width="32" height="32" viewBox="0 0 46 46"><rect x="2" y="10" width="42" height="30" rx="6" stroke="white" stroke-width="2" fill="none"/><circle cx="23" cy="25" r="10" stroke="white" stroke-width="2" fill="none"/><circle cx="23" cy="25" r="3.5" fill="white"/><path d="M11 5h24l3 5h5v3H3v-3h5l3-5z" fill="white" opacity=".2"/></svg>
      <span>Sara Sánchez</span>
    </a>
    <div class="desk-links">
      <a href="#servicios" class="link">Servicios</a><a href="#galeria" class="link">Galería</a><a href="#sobre-mi" class="link">Sobre mí</a><a href="https://wa.me/593939001348?text=Hola+Sara!+%E2%9C%A8" class="link">Contacto</a>
    </div>
    <button class="ham" id="ham" onclick="toggleMenu()"><span></span><span></span><span></span></button>
  </nav>
  <div class="mmenu" id="mmenu" onclick="toggleMenu()">
    <button onclick="event.stopPropagation();toggleMenu()" style="position:absolute;top:1.2rem;right:1.2rem;color:#fff;font-size:2rem;background:none;border:none;cursor:pointer;width:44px;height:44px;display:flex;align-items:center;justify-content:center;z-index:1">&times;</button>
    <a href="#servicios" onclick="event.stopPropagation();toggleMenu()">Servicios</a>
    <a href="#galeria" onclick="event.stopPropagation();toggleMenu()">Galería</a>
    <a href="#sobre-mi" onclick="event.stopPropagation();toggleMenu()">Sobre mí</a>
    <a href="#proceso" onclick="event.stopPropagation();toggleMenu()">Proceso</a>
    <a href="https://wa.me/593939001348?text=Hola+Sara!+%E2%9C%A8" onclick="event.stopPropagation();toggleMenu()">Contacto</a>
  </div>
  <main><slot /></main>
  <a href="https://wa.me/593939001348?text=Hola+Sara!+%E2%9C%A8" class="float-wa" target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
  </a>
  <footer><p>© 2026 Sara Sánchez – Fotografía · Guayaquil, Ecuador</p></footer>
  <script>
    function toggleMenu(){document.getElementById('mmenu').classList.toggle('open');document.getElementById('ham').classList.toggle('active');document.body.style.overflow=document.getElementById('mmenu').classList.contains('open')?'hidden':''}
    window.addEventListener('scroll',function(){document.getElementById('nav').classList.toggle('scrolled',window.scrollY>50)});
  </script>
</body>
</html>
